# Copy to terraform.tfvars and adjust. Do NOT commit terraform.tfvars.

# Azure subscription to deploy into (or export ARM_SUBSCRIPTION_ID instead).
# subscription_id = "00000000-0000-0000-0000-000000000000"

location            = "westeurope"
resource_group_name = "rg-hybrid-connectivity"
name_prefix         = "hybnet"

admin_username = "azureuser"

# Paste the contents of your public key (e.g. ~/.ssh/id_ed25519.pub).
admin_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Override the default pre-shared key before any real deployment.
# vpn_shared_key = "use-a-strong-secret-here"
